{
  "name": "CockpitDevelopmentDependencies",
  "description": "Cockpit isn't a Node package, these are devel time deps, not needed to build tarball either",
  "type": "module",
  "private": true,
  "dependencies": {
    "@patternfly/patternfly": "6.7.0",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-icons": "6.7.0",
    "@patternfly/react-styles": "6.7.0",
    "@patternfly/react-table": "6.7.0",
    "@patternfly/react-tokens": "6.7.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "argparse": "3.0.4",
    "dequal": "2.0.3",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "3.7.0",
    "gettext-parser": "10.0.0",
    "ipaddr.js": "2.5.0",
    "json-stable-stringify-without-jsonify": "1.0.1",
    "markdown-to-jsx": "9.10.3",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "throttle-debounce": "5.0.2",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/qunit": "2.19.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/throttle-debounce": "5.0.2",
    "esbuild-wasm": "0.28.2",
    "oxlint": "1.90.0",
    "qunit": "3.0.0",
    "qunit-tap": "1.5.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-formatter-pretty": "4.0.1",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "lint": "oxlint pkg/ test/common/",
    "lint:fix": "oxlint --fix pkg/ test/common/",
    "stylelint": "stylelint pkg/*/*.{css,scss}",
    "stylelint:fix": "stylelint --fix pkg/*/*.{css,scss}"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
